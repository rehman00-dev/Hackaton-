PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
CLIENT_ORIGIN=http://localhost:5173
APP_TIME_ZONE=Asia/Karachi
GROQ_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
DATABASE_URL=
# Use the Supabase PostgreSQL connection string from Project Settings > Database.
# Keep this server-only; never expose it as a VITE_ variable or commit its real value.
# Optional: create the first Admin automatically on a fresh database.
# Otherwise, create the first Admin from the first-run setup screen.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace_with_a_strong_password
